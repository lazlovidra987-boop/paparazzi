<!DOCTYPE module SYSTEM "module.dtd">

<module name="gate_navigator" dir="gate_navigator">
  <doc>
    <description>Flies the drone through a gate detected by cv_detect_gate.</description>
  </doc>
  
  <settings>
    <dl_settings>
      <dl_settings name="Gate Navigator">
        <dl_setting var="nav_search_rate" min="0.0" step="0.5" max="10" shortname="Search Rate"/>
        <dl_setting var="pass_time_s" min="0.0" step="0.1" max="10" shortname="Pass Time"/>
        <dl_setting var="nav_quality_thresh" min="0.0" step="0.01" max="1.0" shortname="Min Quality"/>
        <dl_setting var="nav_align_thresh" min="0.01" step="0.01" max="0.5" shortname="Align Thresh"/>
        <dl_setting var="nav_forward_speed" min="0.0" step="0.1" max="2.0" shortname="Fwd Speed"/>
      </dl_settings>
    </dl_settings>
  </settings>
  
  <dep>
    <depends>cv_detect_gate</depends>
  </dep>

  <header>
    <file name="gate_navigator.h"/>
  </header>
  
  <init fun="gate_navigator_init()"/>
  <periodic fun="gate_navigator_periodic()" freq="10"/>
  
  <makefile target="ap|nps">
    <file name="gate_navigator.c"/>
  </makefile>
</module>