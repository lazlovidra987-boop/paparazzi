<!DOCTYPE module SYSTEM "module.dtd">

<module name="gate_cnn" dir="gate_cnn">
  <doc>
    <description>CNN MODULE: periodic benchmark for gate CNN on Bebop.</description>
  </doc>

  <header>
    <file name="cnn.h"/>
    <file name="cnn_benchmark.h"/>
  </header>

  <!-- CNN MODULE: initialization -->
  <init fun="gate_cnn_benchmark_init()"/>

  <!-- CNN MODULE: periodic benchmark execution -->
  <periodic fun="gate_cnn_benchmark_periodic()" freq="10"/>

  <makefile target="ap|nps">
    <file name="cnn.c"/>
    <file name="cnn_benchmark.c"/>
  </makefile>
</module>