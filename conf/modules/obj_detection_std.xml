<!DOCTYPE module SYSTEM "module.dtd">

<module name="obj_detection_std" dir="computer_vision">
  <doc>
    <description>
      Edge Detector CV
      Detects edges and highly textured areas in a video stream by calculating the standard deviation of luminance in discrete pixel blocks. Optionally draws highlighting rectangles on the image.
    </description>
    
    <define name="EDGE_DETECTOR_CAMERA" value="front_camera|bottom_camera" description="Video device to use"/>
    <define name="EDGE_DETECTOR_FPS" value="0" description="Desired FPS (0: camera rate)"/>
    <define name="EDGE_DETECTOR_BLOCK_SIZE" value="10" description="Default size of the pixel block"/>
    <define name="EDGE_DETECTOR_STD_DEV_THRESHOLD" value="40" description="Default standard deviation threshold"/>
    <define name="EDGE_DETECTOR_DRAW_EDGES" value="FALSE|TRUE" description="Whether or not to draw rectangles on image"/>
  </doc>

  <settings>
    <dl_settings>
      <dl_settings name="Obj Detection Std">
         <dl_setting var="edge_block_size" min="2" step="1" max="50" shortname="block_size"/>
         <dl_setting var="edge_std_dev_threshold" min="0" step="1" max="150" shortname="threshold"/>
         <dl_setting var="edge_draw_edges" min="0" step="1" max="1" values="False|True" shortname="draw_edges" />
      </dl_settings>
    </dl_settings>
  </settings>

  <dep>
    <depends>video_thread</depends>
  </dep>

  <header>
    <file name="obj_detection_std.h"/>
  </header>

  <init fun="edge_detector_init()"/>
  <periodic fun="edge_detector_periodic()" freq="50"/>
  
  <makefile target="ap|nps">
    <file name="obj_detection_std.c"/>
  </makefile>
</module>