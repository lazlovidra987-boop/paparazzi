<module name="cv_ground_seg" dir="ground_seg" type="cv">
  <doc>
    <description>Ground Segmentation Module
    Detects ground based on a color filter. Optionally draws on image.
    </description>
    <define name="GROUND_SEGMENTATION_CAMERA" value="front_camera" description="Video device to use"/>
    <define name="GROUND_SEGMENTATION_FPS" value="0" description="Desired FPS (0: camera rate)"/>
    <define name="GROUND_SEGMENTATION_DRAW" value="TRUE|FALSE" description="Whether or not to draw on image"/>
  </doc>

  <settings>
    <dl_settings>
      <dl_setting var="ground_lum_min" min="0" step="1" max="255" shortname="y_min"/>
      <dl_setting var="ground_lum_max" min="0" step="1" max="255" shortname="y_max"/>
      <dl_setting var="ground_cb_min" min="0" step="1" max="255" shortname="u_min"/>
      <dl_setting var="ground_cb_max" min="0" step="1" max="255" shortname="u_max"/>
      <dl_setting var="ground_cr_min" min="0" step="1" max="255" shortname="v_min"/>
      <dl_setting var="ground_cr_max" min="0" step="1" max="255" shortname="v_max"/>
      <dl_setting var="ground_draw" min="0" step="1" max="1" values="False|True" shortname="draw"/>
    </dl_settings>
  </settings>

  <dep>
    <depends>video_thread</depends>
  </dep>

  <header>
    <file name="cv_ground_seg.h"/>
  </header>

  <init fun="ground_segmentation_init()"/>
  <periodic fun="ground_segmentation_periodic()" freq="50"/>
  <makefile target="ap|nps">
    <file name="cv_ground_seg.c"/>
  </makefile>
</module>